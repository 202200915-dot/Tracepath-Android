# Copy this file to "keystore.properties" (same folder) and fill in your
# real values. keystore.properties and *.jks/*.keystore are already
# git-ignored — never commit your real signing key.
#
# Create a keystore first (one-time, keep the .jks file and passwords safe —
# you need the SAME key for every future update of this app):
#   keytool -genkeypair -v -keystore tracepath-release.jks -alias tracepath \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is relative to the android/ folder.
storeFile=tracepath-release.jks
storePassword=CHANGE_ME
keyAlias=tracepath
keyPassword=CHANGE_ME
